{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information, presence, and social profile.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "isOnline": { "type": "boolean" },
        "username": { "type": "string" },
        "bio": { "type": "string" },
        "bannerURL": { "type": "string" },
        "statusMessage": { "type": "string" },
        "statusEmoji": { "type": "string" },
        "availability": { "type": "string", "enum": ["online", "busy", "away", "offline"] },
        "socialLinks": {
          "type": "object",
          "properties": {
            "github": { "type": "string" },
            "twitter": { "type": "string" },
            "website": { "type": "string" }
          }
        },
        "interests": { "type": "array", "items": { "type": "string" } },
        "privacySettings": {
          "type": "object",
          "properties": {
            "showPhoto": { "type": "string", "enum": ["everyone", "contacts", "nobody"] },
            "showLastSeen": { "type": "boolean" },
            "allowDirectMessages": { "type": "boolean" }
          }
        }
      },
      "required": ["uid", "displayName", "email"]
    },
    "Chat": {
      "title": "Chat Discussion",
      "description": "A conversation between two or more users.",
      "type": "object",
      "properties": {
        "chatId": { "type": "string" },
        "participants": { 
          "type": "array",
          "items": { "type": "string" }
        },
        "type": { "type": "string", "enum": ["one-to-one", "group"] },
        "name": { "type": "string" },
        "photoURL": { "type": "string" },
        "lastMessage": { 
          "type": "object",
          "properties": {
            "text": { "type": "string" },
            "senderId": { "type": "string" },
            "timestamp": { "type": "string", "format": "date-time" }
          }
        },
        "unreadCount": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["chatId", "participants", "type", "createdAt"]
    },
    "Message": {
      "title": "Message Content",
      "description": "Individual message sent in a chat.",
      "type": "object",
      "properties": {
        "messageId": { "type": "string" },
        "chatId": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "image", "video", "file"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["sent", "delivered", "read"] },
        "mediaUrl": { "type": "string" }
      },
      "required": ["messageId", "chatId", "senderId", "timestamp", "status"]
    },
    "WhiteboardStroke": {
      "title": "3D Whiteboard Stroke",
      "description": "A single continuous line drawn in 3D space.",
      "type": "object",
      "properties": {
        "strokeId": { "type": "string" },
        "chatId": { "type": "string" },
        "senderId": { "type": "string" },
        "points": { 
          "type": "array",
          "items": { "type": "number" }
        },
        "color": { "type": "string" },
        "width": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["strokeId", "chatId", "senderId", "points", "color", "width", "timestamp"]
    },
    "CallSession": {
      "title": "Voice/Video Call Session",
      "description": "Metadata for an active or completed call.",
      "type": "object",
      "properties": {
        "callId": { "type": "string" },
        "hostId": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "type": { "type": "string", "enum": ["audio", "video"] },
        "status": { "type": "string", "enum": ["ringing", "connected", "ended", "missed", "rejected"] },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "duration": { "type": "integer" },
        "isGroup": { "type": "boolean" },
        "chatId": { "type": "string" },
        "summary": { "type": "string" }
      },
      "required": ["callId", "hostId", "participants", "type", "status", "startTime"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Public and private user profile data."
    },
    "/usernames/{username}": {
      "schema": {
        "type": "object",
        "properties": {
          "uid": { "type": "string" }
        }
      },
      "description": "Index for ensuring unique usernames."
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Chat metadata and summary."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Message history for a specific chat."
    },
    "/chats/{chatId}/whiteboard_strokes/{strokeId}": {
      "schema": "WhiteboardStroke",
      "description": "Real-time 3D drawing strokes for the chat session."
    },
    "/chats/{chatId}/typing/{userId}": {
      "schema": {
        "type": "object",
        "properties": {
          "isTyping": { "type": "boolean" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "description": "Transient typing indicators."
    },
    "/calls/{callId}": {
      "schema": "CallSession",
      "description": "Historical and active call records."
    },
    "/calls/{callId}/signaling/{signalId}": {
      "schema": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["offer", "answer", "candidate"] },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "payload": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      },
      "description": "WebRTC signaling messages."
    }
  }
}
