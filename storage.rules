rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isChatParticipant(chatId) {
      let chatPath = /databases/ai-studio-e316c560-bff4-411c-9095-0c6d6acbe77f/documents/chats/$(chatId);
      return request.auth != null &&
        firestore.exists(chatPath) &&
        request.auth.uid in firestore.get(chatPath).data.participants;
    }

    function isAllowedChatFile() {
      return request.resource.size <= 50 * 1024 * 1024 &&
        (
          request.resource.contentType.matches('image/(jpeg|png|gif|webp)') ||
          request.resource.contentType.matches('video/(mp4|webm|quicktime)') ||
          request.resource.contentType.matches('audio/(webm|ogg|mpeg|wav|mp4)') ||
          request.resource.contentType in [
            'application/pdf',
            'application/msword',
            'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
          ]
        );
    }

    match /chats/{chatId}/{uploaderId}/{fileName} {
      allow read: if isChatParticipant(chatId);
      allow create: if isChatParticipant(chatId) &&
        request.auth.uid == uploaderId &&
        isAllowedChatFile();
      allow update: if false;
      allow delete: if isChatParticipant(chatId) &&
        request.auth.uid == uploaderId;
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|gif|webp)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
